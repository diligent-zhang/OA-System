<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianyu.oasystem.mapper.SysNoticeAttachmentMapper">

    <sql id="columns">
        id, notice_id, file_id, original_name, size, upload_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_notice_attachment (notice_id, file_id, original_name, size)
        VALUES (#{noticeId}, #{fileId}, #{originalName}, #{size})
    </insert>

    <select id="selectByNoticeId" resultType="SysNoticeAttachment">
        SELECT <include refid="columns"/>
        FROM sys_notice_attachment
        WHERE notice_id = #{noticeId}
        ORDER BY id ASC
    </select>

    <select id="selectById" resultType="SysNoticeAttachment">
        SELECT <include refid="columns"/>
        FROM sys_notice_attachment
        WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM sys_notice_attachment WHERE id = #{id}
    </delete>

    <delete id="deleteByNoticeId">
        DELETE FROM sys_notice_attachment WHERE notice_id = #{noticeId}
    </delete>

</mapper>