<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianyu.oasystem.mapper.SysOpLogMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_op_log (user_id, username, op_type, biz_type, biz_id, detail, ip)
        VALUES (#{userId}, #{username}, #{opType}, #{bizType}, #{bizId}, #{detail}, #{ip})
    </insert>

    <sql id="queryConditions">
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="opType != null and opType != ''">AND op_type = #{opType}</if>
            <if test="beginTime != null and beginTime != ''">AND create_time &gt;= #{beginTime}</if>
            <if test="endTime != null and endTime != ''">AND create_time &lt;= CONCAT(#{endTime}, ' 23:59:59')</if>
        </where>
    </sql>

    <select id="selectPage" resultType="SysOpLog">
        SELECT id, user_id, username, op_type, biz_type, biz_id, detail, ip, create_time
        FROM sys_op_log
        <include refid="queryConditions"/>
        ORDER BY id DESC
    </select>

</mapper>